Require Import isla.riscv64.riscv64.
Require Import ZesuSsz.Experiments.WriteSuccessCoverageAutomation.

Lemma writeSuccess__SOURCE_PC__ReadBackedValueCovered local global labels
    afterLocal afterGlobal spawned trace' (address declared actual : bv 64) :
  local.(seq_trace) = ReadMem (RVal_Bits (bv_to_bvn declared)) RegVal_Poison
    (RVal_Bits (bv_to_bvn address)) 8 None Mk_annot :t: trace' ->
  read_mem global.(seq_mem) (bv_unsigned address) 8 = Some (bv_to_bvn actual) ->
  afterLocal.(seq_nb_state) = false ->
  seq_step local global labels afterLocal afterGlobal spawned ->
  declared = actual /\ labels = [] /\
  afterLocal = local <| seq_trace := trace' |> /\ afterGlobal = global /\ spawned = [].
Proof.
  intros Hsource Hread Hafter Hstep.
  inversion Hstep as [stepGlobal stepLocal event next event' nextLocal nextGlobal
    Hnb Htrace Hsem]; subst.
  rewrite Hsource in Htrace. inversion Htrace; subst. cbn in Hsem.
  destruct Hsem as (actualAddress & actualValue & memoryValue & Hsem).
  destruct Hsem as (Haddress & Hvalue & Hlen & Hbranch).
  apply writeSuccessBitsValInjective in Haddress. subst actualAddress.
  apply writeSuccessBitsValInjective in Hvalue. subst actualValue.
  rewrite Hread in Hbranch. destruct Hbranch as (Hmemory & -> & -> & Hsuccess).
  assert (HmemoryValue : bv_to_bvn actual = bv_to_bvn memoryValue) by congruence.
  apply writeSuccessBvToBvnInjective in HmemoryValue. subst memoryValue.
  destruct Hsuccess as [(-> & Hmatch)|Hblock].
  - subst declared.
    repeat split; reflexivity.
  - subst. discriminate Hafter.
Qed.

Print Assumptions writeSuccess__SOURCE_PC__ReadBackedValueCovered.

Lemma writeSuccess__SOURCE_PC__ReadMmioValueCovered local global labels
    afterLocal afterGlobal spawned trace' (address value : bv 64) :
  local.(seq_trace) = ReadMem (RVal_Bits (bv_to_bvn value)) RegVal_Poison
    (RVal_Bits (bv_to_bvn address)) 8 None Mk_annot :t: trace' ->
  read_mem global.(seq_mem) (bv_unsigned address) 8 = None ->
  seq_step local global labels afterLocal afterGlobal spawned ->
  labels = [SReadMem address (bv_to_bvn value)] /\
  afterLocal = local <| seq_trace := trace' |> /\ afterGlobal = global /\ spawned = [].
Proof.
  intros Hsource Hread Hstep.
  inversion Hstep as [stepGlobal stepLocal event next event' nextLocal nextGlobal
    Hnb Htrace Hsem]; subst.
  rewrite Hsource in Htrace. inversion Htrace; subst. cbn in Hsem.
  destruct Hsem as (actualAddress & actualValue & ignoredValue & Hsem).
  destruct Hsem as (Haddress & Hvalue & Hlen & Hbranch).
  apply writeSuccessBitsValInjective in Haddress. subst actualAddress.
  apply writeSuccessBitsValInjective in Hvalue. subst actualValue.
  rewrite Hread in Hbranch. destruct Hbranch as (_ & _ & -> & -> & ->).
  repeat split; reflexivity.
Qed.

Print Assumptions writeSuccess__SOURCE_PC__ReadMmioValueCovered.
