Lemma segment___SOURCE_PC___covered (regs : reg_map) (global : seq_global_state)
    (mstatusBits address satp value oldDest : bv 64) observations after :
  regs !! "PC" = Some (RVal_Bits (Z_to_bv 64 0x__SOURCE_PC__)) ->
  regs !! "__BASE_REGISTER__" = Some (RVal_Bits address) ->
  regs !! "mstatus" = Some (RegVal_Struct [("bits", RVal_Bits mstatusBits)]) ->
  regs !! "satp" = Some (RVal_Bits satp) ->
  regs !! "__DEST_REGISTER__" = Some (RVal_Bits oldDest) ->
  writeSuccess__SOURCE_PC__SysRegs regs ->
  eval_a_exp regs writeSuccess15694Mstatus = Some (Val_Bool true) ->
  eval_a_exp regs writeSuccess__SOURCE_PC__Aligned = Some (Val_Bool true) ->
  eval_a_exp regs writeSuccess__SOURCE_PC__Lower = Some (Val_Bool true) ->
  eval_a_exp regs writeSuccess__SOURCE_PC__Upper = Some (Val_Bool true) ->
  read_mem global.(seq_mem) (bv_unsigned (writeSuccess__SOURCE_PC__Address address)) 8 =
    Some (bv_to_bvn value) ->
  global.(seq_instrs) !! Z_to_bv 64 0x__SOURCE_PC__ = Some a__SOURCE_PC__ ->
  global.(seq_instrs) !! Z_to_bv 64 0x__NEXT_PC__ = Some a__NEXT_PC__ ->
  IslaInstructionSegment (writeSuccess__SOURCE_PC__Before regs global) observations after ->
  after = writeSuccess__SOURCE_PC__After regs global value /\
  observations = writeSuccess__SOURCE_PC__Observations regs global
    mstatusBits address satp value.
Proof.
  intros Hpc Hx2 Hmstatus Hsatp Hdest Hsys HmstatusAssume Haligned Hlower Hupper
    Hmem Hcode Hnext Hsegment.
  destruct (segment___SOURCE_PC___prefix5_covered regs global mstatusBits address satp value
    observations after Hsys Hsegment) as
    (done & labels & spawned & prefix5 & Hp5 & Hnil & Hdone & Hend & Hobs).
  destruct (segment___SOURCE_PC___second5_covered regs global mstatusBits address satp value
    prefix5 done labels spawned after Hsys Hp5 Hnil Hdone) as (prefix10 & Hp10 & Hobs2).
  destruct (segment___SOURCE_PC___middle_first_covered regs global prefix10 done labels spawned
    after HmstatusAssume Haligned Hlower Hupper Hp10 Hnil Hdone) as
    (declMstatus & declAddress & prefix15 & Hp15 & Hobs3).
  destruct (segment___SOURCE_PC___middle_second_covered regs global declMstatus declAddress
    mstatusBits address prefix15 done labels spawned after Hpc Hx2 Hmstatus Hupper
    Hp15 Hnil Hdone) as (-> & -> & prefix21 & Hp21 & Hobs4).
  destruct (segment___SOURCE_PC___suffix_backed_covered regs global mstatusBits address satp
    value oldDest prefix21 done labels spawned after Hpc Hsatp Hdest Hmem Hnext Hp21 Hnil Hdone)
    as (Hafter & Hobs5). subst after.
  split; first reflexivity. rewrite Hobs. rewrite Hobs2. rewrite Hobs3. rewrite Hobs4.
  repeat rewrite <- app_assoc. cbn [List.app]. rewrite Hobs5.
  unfold writeSuccess__SOURCE_PC__Observations,
    writeSuccess__SOURCE_PC__ExecutionPrefix,
    writeSuccess__SOURCE_PC__PreReadObservations,
    writeSuccess__SOURCE_PC__PostReadPrefix,
    writeSuccess__SOURCE_PC__First5Observations,
    writeSuccess__SOURCE_PC__Second5Observations,
    writeSuccess__SOURCE_PC__MiddleFirstObservations,
    writeSuccess__SOURCE_PC__MiddleSecondObservations,
    writeSuccess__SOURCE_PC__SuffixObservations,
    writeSuccess__SOURCE_PC__PrefixObservations. cbn. reflexivity.
Qed.

