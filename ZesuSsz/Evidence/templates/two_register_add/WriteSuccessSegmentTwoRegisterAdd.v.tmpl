  regs !! "__LEFT_REGISTER__" = Some (RVal_Bits left) ->
  regs !! "__RIGHT_REGISTER__" = Some (RVal_Bits right) ->
  regs !! "__DEST_REGISTER__" = Some old__DEST_UPPER__ ->
  global.(seq_instrs) !! Z_to_bv 64 0x__SOURCE_PC__ = Some a__SOURCE_PC__ ->
  global.(seq_instrs) !! Z_to_bv 64 0x__NEXT_PC__ = Some a__NEXT_PC__ ->
  eval_a_exp regs writeSuccess15694Mstatus = Some (Val_Bool true) ->
  IslaInstructionSegment (writeSuccess__SOURCE_PC__Before regs global)
    (writeSuccess__SOURCE_PC__Observations regs global left right)
    (writeSuccess__SOURCE_PC__After regs global left right) /\
  (writeSuccess__SOURCE_PC__After regs global left right).1.(seq_regs) =
    writeSuccess__SOURCE_PC__Regs regs left right /\
  (writeSuccess__SOURCE_PC__After regs global left right).2.(seq_mem) = global.(seq_mem) /\
  concat (map microLabels
    (writeSuccess__SOURCE_PC__Observations regs global left right)) = [].
Proof.
  intros Hpc Hleft Hright Hdest Hcode Hnext Hmstatus.
  split; [|repeat split; reflexivity].
  unfold writeSuccess__SOURCE_PC__Observations.
  eapply islaInstructionSegmentIntro with
    (done := (writeSuccess15694Local tnil
      (writeSuccess__SOURCE_PC__Regs regs left right), global))
    (labels := []) (spawned := []).
  - split; first reflexivity. exists (Z_to_bv 64 0x__SOURCE_PC__), a__SOURCE_PC__.
    cbn. rewrite Hpc Hcode. repeat split; reflexivity.
  - eapply writeSuccess__SOURCE_PC__PrefixPath; eauto.
  - reflexivity.
  - apply writeSuccessSeqDoneTabled with (next := a__NEXT_PC__) (trace := a__NEXT_PC__).
    + reflexivity. + reflexivity. + constructor.
    + exists (Z_to_bv 64 0x__NEXT_PC__). unfold writeSuccess__SOURCE_PC__Regs.
      rewrite lookup_insert. rewrite writeSuccess__SOURCE_PC__NextPcExact Hnext.
      repeat split; reflexivity.
  - left. split; first reflexivity. exists (Z_to_bv 64 0x__NEXT_PC__), a__NEXT_PC__.
    cbn. unfold writeSuccess__SOURCE_PC__Regs. rewrite lookup_insert.
    rewrite writeSuccess__SOURCE_PC__NextPcExact Hnext. repeat split; reflexivity.
Qed.

