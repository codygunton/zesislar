Definition writeSuccessTraceTail (trace : isla_trace) : isla_trace :=
  match trace with tcons _ rest => rest | _ => tnil end.

Definition writeSuccess__SOURCE_PC__Mstatus : a_exp :=
  AExp_Binop Eq
    (AExp_Manyop (Bvmanyarith Bvand)
      [AExp_Val (AVal_Var "mstatus" [Field "bits"]) Mk_annot;
       AExp_Val (AVal_Bits (BV 64 0x20000)) Mk_annot] Mk_annot)
    (AExp_Val (AVal_Bits (BV 64 0)) Mk_annot) Mk_annot.

Definition writeSuccess__SOURCE_PC__Trace1 :=
  subst_trace (Val_Bits (BV 64 0)) 2 (writeSuccessTraceTail a__SOURCE_PC__).
Definition writeSuccess__SOURCE_PC__Trace2 := writeSuccessTraceTail writeSuccess__SOURCE_PC__Trace1.
Definition writeSuccess__SOURCE_PC__Trace3 :=
  subst_trace (Val_Bits (Z_to_bv 64 0x__SOURCE_PC__)) 3
    (writeSuccessTraceTail writeSuccess__SOURCE_PC__Trace2).
Definition writeSuccess__SOURCE_PC__Trace4 := writeSuccessTraceTail writeSuccess__SOURCE_PC__Trace3.
Definition writeSuccess__SOURCE_PC__NextPc : bv 64 :=
  (Z_to_bv 64 0x__SOURCE_PC__ + BV 64 4)%bv.
Definition writeSuccess__SOURCE_PC__Trace5 :=
  subst_trace (Val_Bits writeSuccess__SOURCE_PC__NextPc) 4
    (writeSuccessTraceTail writeSuccess__SOURCE_PC__Trace4).
Definition writeSuccess__SOURCE_PC__Trace6 (sp : bv 64) :=
  subst_trace (Val_Bits sp) 5 (writeSuccessTraceTail writeSuccess__SOURCE_PC__Trace5).
Definition writeSuccess__SOURCE_PC__Trace7 (sp : bv 64) :=
  writeSuccessTraceTail (writeSuccess__SOURCE_PC__Trace6 sp).
Definition writeSuccess__SOURCE_PC__Trace8 (sp : bv 64) :=
  subst_trace (Val_Bits (sp + BV 64 __ADDEND__)%bv) 6
    (writeSuccessTraceTail (writeSuccess__SOURCE_PC__Trace7 sp)).
Definition writeSuccess__SOURCE_PC__Trace9 (sp : bv 64) :=
  writeSuccessTraceTail (writeSuccess__SOURCE_PC__Trace8 sp).
Definition writeSuccess__SOURCE_PC__Trace10 (sp : bv 64) :=
  writeSuccessTraceTail (writeSuccess__SOURCE_PC__Trace9 sp).

Definition writeSuccess__SOURCE_PC__Regs (regs : reg_map) (sp : bv 64) : reg_map :=
  <["PC" := RVal_Bits writeSuccess__SOURCE_PC__NextPc]>
    (<["__DEST_REGISTER__" := RVal_Bits (sp + BV 64 __ADDEND__)%bv]> regs).

Lemma writeSuccess__SOURCE_PC__RegsLookupOther regs sp reg :
  reg <> "PC" ->
  reg <> "__DEST_REGISTER__" ->
  writeSuccess__SOURCE_PC__Regs regs sp !! reg = regs !! reg.
Proof.
  intros Hpc Hx10. unfold writeSuccess__SOURCE_PC__Regs.
  rewrite lookup_insert_ne; last congruence.
  rewrite lookup_insert_ne; last congruence.
  reflexivity.
Qed.

Definition writeSuccess__SOURCE_PC__Local (trace : isla_trace) (regs : reg_map) :
    seq_local_state := {|
  seq_trace := trace;
  seq_regs := regs;
  seq_pc_reg := "PC";
  seq_nb_state := false
|}.

Definition writeSuccess__SOURCE_PC__Before (regs : reg_map)
    (global : seq_global_state) : IslaState :=
  (writeSuccess__SOURCE_PC__Local a__SOURCE_PC__ regs, global).

Definition writeSuccess__SOURCE_PC__After (regs : reg_map) (global : seq_global_state)
    (sp : bv 64) : IslaState :=
  (writeSuccess__SOURCE_PC__Local a__NEXT_PC__ (writeSuccess__SOURCE_PC__Regs regs sp), global).

Definition writeSuccess__SOURCE_PC__Observation (local : seq_local_state)
    (global : seq_global_state) : IslaMicroObservation := {|
  microLabels := [];
  microAfter := (local, global)
|}.

Lemma writeSuccess__SOURCE_PC__NextPcExact :
  writeSuccess__SOURCE_PC__NextPc = Z_to_bv 64 0x__NEXT_PC__.
Proof. unfold writeSuccess__SOURCE_PC__NextPc. bv_solve. Qed.

Definition writeSuccess__SOURCE_PC__PrefixObservations (regs : reg_map)
    (global : seq_global_state) (sp : bv 64) : list IslaMicroObservation :=
  [writeSuccess__SOURCE_PC__Observation
     (writeSuccess__SOURCE_PC__Local writeSuccess__SOURCE_PC__Trace1 regs) global;
   writeSuccess__SOURCE_PC__Observation
     (writeSuccess__SOURCE_PC__Local writeSuccess__SOURCE_PC__Trace2 regs) global;
   writeSuccess__SOURCE_PC__Observation
     (writeSuccess__SOURCE_PC__Local writeSuccess__SOURCE_PC__Trace3 regs) global;
   writeSuccess__SOURCE_PC__Observation
     (writeSuccess__SOURCE_PC__Local writeSuccess__SOURCE_PC__Trace4 regs) global;
   writeSuccess__SOURCE_PC__Observation
     (writeSuccess__SOURCE_PC__Local writeSuccess__SOURCE_PC__Trace5 regs) global;
   writeSuccess__SOURCE_PC__Observation
     (writeSuccess__SOURCE_PC__Local (writeSuccess__SOURCE_PC__Trace6 sp) regs) global;
   writeSuccess__SOURCE_PC__Observation
     (writeSuccess__SOURCE_PC__Local (writeSuccess__SOURCE_PC__Trace7 sp) regs) global;
   writeSuccess__SOURCE_PC__Observation
     (writeSuccess__SOURCE_PC__Local (writeSuccess__SOURCE_PC__Trace8 sp) regs) global;
   writeSuccess__SOURCE_PC__Observation
     (writeSuccess__SOURCE_PC__Local (writeSuccess__SOURCE_PC__Trace9 sp)
       (<["__DEST_REGISTER__" := RVal_Bits (sp + BV 64 __ADDEND__)%bv]> regs)) global;
   writeSuccess__SOURCE_PC__Observation
     (writeSuccess__SOURCE_PC__Local (writeSuccess__SOURCE_PC__Trace10 sp)
       (writeSuccess__SOURCE_PC__Regs regs sp)) global].

Definition writeSuccess__SOURCE_PC__Observations (regs : reg_map)
    (global : seq_global_state) (sp : bv 64) : list IslaMicroObservation :=
  writeSuccess__SOURCE_PC__PrefixObservations regs global sp ++
  [writeSuccess__SOURCE_PC__Observation
     (writeSuccess__SOURCE_PC__After regs global sp).1 global].

Lemma writeSuccess__SOURCE_PC__MstatusFromTraceAssumptions regs global :
  writeSuccessTraceAssumptions (writeSuccess__SOURCE_PC__Before regs global) ->
  eval_a_exp regs writeSuccess__SOURCE_PC__Mstatus = Some (Val_Bool true).
Proof.
  intros Hassumptions.
  apply Forall_forall with
    (x := Assume writeSuccess__SOURCE_PC__Mstatus Mk_annot :t: tnil)
    in Hassumptions.
  - exact Hassumptions.
  - unfold writeSuccessTraceAssumptionEvents.
    rewrite elem_of_list_In.
    apply in_concat. exists writeSuccessTraceAssumptionsChunk11.
    split.
    + cbn. tauto.
    + unfold writeSuccessTraceAssumptionsChunk11,
        writeSuccess__SOURCE_PC__Mstatus. cbn. tauto.
Qed.

Lemma writeSuccess__SOURCE_PC__TakeStep before observations done :
  IslaInstructionPrefixPath before observations done ->
  before.1.(seq_trace) <> tnil ->
  done.1.(seq_trace) = tnil ->
  done.1.(seq_nb_state) = false ->
  exists labels middleLocal middleGlobal spawned rest,
    observations =
      {| microLabels := labels;
         microAfter := (middleLocal, middleGlobal) |} :: rest /\
    seq_step before.1 before.2 labels middleLocal middleGlobal spawned /\
    middleLocal.(seq_nb_state) = false /\
    IslaInstructionPrefixPath (middleLocal, middleGlobal) rest done.
Proof.
  intros Hpath Hsource HdoneTrace HdoneNb.
  exact (writeSuccessInstructionPrefixTakeStep before observations done
    Hsource HdoneTrace HdoneNb Hpath).
Qed.

Lemma segment___SOURCE_PC___mstatus (regs : reg_map) (global : seq_global_state)
    (sp : bv 64) old__DEST_UPPER__ :
  regs !! "PC" = Some (RVal_Bits (Z_to_bv 64 0x__SOURCE_PC__)) ->
  regs !! "__SOURCE_REGISTER__" = Some (RVal_Bits sp) ->
  regs !! "__DEST_REGISTER__" = Some old__DEST_UPPER__ ->
  global.(seq_instrs) !! Z_to_bv 64 0x__SOURCE_PC__ = Some a__SOURCE_PC__ ->
  global.(seq_instrs) !! Z_to_bv 64 0x__NEXT_PC__ = Some a__NEXT_PC__ ->
  eval_a_exp regs writeSuccess__SOURCE_PC__Mstatus = Some (Val_Bool true) ->
  IslaInstructionSegment (writeSuccess__SOURCE_PC__Before regs global)
    (writeSuccess__SOURCE_PC__Observations regs global sp)
    (writeSuccess__SOURCE_PC__After regs global sp) /\
  (writeSuccess__SOURCE_PC__After regs global sp).1.(seq_regs) =
    writeSuccess__SOURCE_PC__Regs regs sp /\
  (writeSuccess__SOURCE_PC__After regs global sp).2.(seq_mem) = global.(seq_mem) /\
  concat (map microLabels (writeSuccess__SOURCE_PC__Observations regs global sp)) = [].
Proof.
  intros Hpc Hsp Hx10 Hcode Hnext Hmstatus.
  split; [|repeat split; reflexivity].
  unfold writeSuccess__SOURCE_PC__Observations.
  eapply islaInstructionSegmentIntro with
    (done := (writeSuccess__SOURCE_PC__Local tnil (writeSuccess__SOURCE_PC__Regs regs sp), global))
    (labels := []) (spawned := []).
  - split; first reflexivity. exists (Z_to_bv 64 0x__SOURCE_PC__), a__SOURCE_PC__.
    cbn. rewrite Hpc Hcode. repeat split; reflexivity.
  - unfold writeSuccess__SOURCE_PC__PrefixObservations.
    eapply IslaInstructionPrefixStep; first discriminate.
    { apply writeSuccessSeqSilent; first reflexivity.
      unfold writeSuccess__SOURCE_PC__Before, writeSuccess__SOURCE_PC__Local,
        writeSuccess__SOURCE_PC__Trace1, writeSuccessTraceTail, a__SOURCE_PC__. cbn.
      apply DeclareConstBitVecS' with (b := BV 64 0). }
    eapply IslaInstructionPrefixStep; first discriminate.
    { apply writeSuccessSeqAssume; first reflexivity.
      unfold writeSuccess__SOURCE_PC__Trace1, writeSuccessTraceTail, a__SOURCE_PC__. cbn.
      eapply AssumeS. exact Hmstatus. }
    eapply IslaInstructionPrefixStep; first discriminate.
    { apply writeSuccessSeqSilent; first reflexivity.
      unfold writeSuccess__SOURCE_PC__Trace2, writeSuccess__SOURCE_PC__Trace1,
        writeSuccessTraceTail, a__SOURCE_PC__. cbn.
      apply DeclareConstBitVecS' with (b := Z_to_bv 64 0x__SOURCE_PC__). }
    eapply IslaInstructionPrefixStep; first discriminate.
    { eapply writeSuccessSeqReadReg with
        (root := RVal_Bits (Z_to_bv 64 0x__SOURCE_PC__))
        (value := RVal_Bits (Z_to_bv 64 0x__SOURCE_PC__)).
      - reflexivity.
      - unfold writeSuccess__SOURCE_PC__Trace3, writeSuccess__SOURCE_PC__Trace2,
          writeSuccess__SOURCE_PC__Trace1, writeSuccessTraceTail, a__SOURCE_PC__. cbn.
        constructor.
      - exact Hpc.
      - reflexivity.
      - reflexivity. }
    eapply IslaInstructionPrefixStep; first discriminate.
    { apply writeSuccessSeqSilent; first reflexivity.
      unfold writeSuccess__SOURCE_PC__Trace5, writeSuccess__SOURCE_PC__Trace4, writeSuccess__SOURCE_PC__Trace3,
        writeSuccess__SOURCE_PC__Trace2, writeSuccess__SOURCE_PC__Trace1,
        writeSuccess__SOURCE_PC__NextPc, writeSuccessTraceTail, a__SOURCE_PC__. cbn.
      eapply DefineConstS with
        (v := Val_Bits (Z_to_bv 64 0x__SOURCE_PC__ + BV 64 4)%bv).
      reflexivity. }
    eapply IslaInstructionPrefixStep; first discriminate.
    { apply writeSuccessSeqSilent; first reflexivity.
      unfold writeSuccess__SOURCE_PC__Trace5, writeSuccess__SOURCE_PC__Trace4,
        writeSuccess__SOURCE_PC__Trace3, writeSuccess__SOURCE_PC__Trace2,
        writeSuccess__SOURCE_PC__Trace1, writeSuccessTraceTail, a__SOURCE_PC__. cbn.
      apply DeclareConstBitVecS' with (b := sp). }
    eapply IslaInstructionPrefixStep; first discriminate.
    { eapply writeSuccessSeqReadReg with
        (root := RVal_Bits sp) (value := RVal_Bits sp).
      - reflexivity.
      - unfold writeSuccess__SOURCE_PC__Trace6, writeSuccess__SOURCE_PC__Trace5,
          writeSuccess__SOURCE_PC__Trace4, writeSuccess__SOURCE_PC__Trace3,
          writeSuccess__SOURCE_PC__Trace2, writeSuccess__SOURCE_PC__Trace1,
          writeSuccessTraceTail, a__SOURCE_PC__. cbn. constructor.
      - exact Hsp.
      - reflexivity.
      - reflexivity. }
    eapply IslaInstructionPrefixStep; first discriminate.
    { apply writeSuccessSeqSilent; first reflexivity.
      unfold writeSuccess__SOURCE_PC__Trace7, writeSuccess__SOURCE_PC__Trace6,
        writeSuccess__SOURCE_PC__Trace5, writeSuccess__SOURCE_PC__Trace4,
        writeSuccess__SOURCE_PC__Trace3, writeSuccess__SOURCE_PC__Trace2,
        writeSuccess__SOURCE_PC__Trace1, writeSuccessTraceTail, a__SOURCE_PC__. cbn.
      eapply DefineConstS with (v := Val_Bits (sp + BV 64 __ADDEND__)%bv).
      reflexivity. }
    eapply IslaInstructionPrefixStep; first discriminate.
    { eapply writeSuccessSeqWriteReg with (root := old__DEST_UPPER__)
        (value := RVal_Bits (sp + BV 64 __ADDEND__)%bv)
        (updated := RVal_Bits (sp + BV 64 __ADDEND__)%bv).
      - reflexivity.
      - unfold writeSuccess__SOURCE_PC__Trace8, writeSuccess__SOURCE_PC__Trace7,
          writeSuccess__SOURCE_PC__Trace6, writeSuccess__SOURCE_PC__Trace5,
          writeSuccess__SOURCE_PC__Trace4, writeSuccess__SOURCE_PC__Trace3,
          writeSuccess__SOURCE_PC__Trace2, writeSuccess__SOURCE_PC__Trace1,
          writeSuccessTraceTail, a__SOURCE_PC__. cbn. constructor.
      - exact Hx10.
      - reflexivity.
      - reflexivity. }
    eapply IslaInstructionPrefixStep; first discriminate.
    { eapply writeSuccessSeqWriteReg with
        (root := RVal_Bits (Z_to_bv 64 0x__SOURCE_PC__))
        (value := RVal_Bits writeSuccess__SOURCE_PC__NextPc)
        (updated := RVal_Bits writeSuccess__SOURCE_PC__NextPc).
      - reflexivity.
      - unfold writeSuccess__SOURCE_PC__Trace9, writeSuccess__SOURCE_PC__Trace8,
          writeSuccess__SOURCE_PC__Trace7, writeSuccess__SOURCE_PC__Trace6,
          writeSuccess__SOURCE_PC__Trace5, writeSuccess__SOURCE_PC__Trace4,
          writeSuccess__SOURCE_PC__Trace3, writeSuccess__SOURCE_PC__Trace2,
          writeSuccess__SOURCE_PC__Trace1, writeSuccessTraceTail, a__SOURCE_PC__. cbn.
        constructor.
      - rewrite lookup_insert_ne; last done. exact Hpc.
      - reflexivity.
      - reflexivity. }
    apply IslaInstructionPrefixRefl.
  - reflexivity.
  - apply writeSuccessSeqDoneTabled with (next := a__NEXT_PC__) (trace := a__NEXT_PC__).
    + reflexivity.
    + reflexivity.
    + constructor.
    + exists (Z_to_bv 64 0x__NEXT_PC__).
      unfold writeSuccess__SOURCE_PC__Regs. rewrite lookup_insert.
      rewrite writeSuccess__SOURCE_PC__NextPcExact Hnext.
      repeat split; reflexivity.
  - left. split; first reflexivity. exists (Z_to_bv 64 0x__NEXT_PC__), a__NEXT_PC__.
    cbn. unfold writeSuccess__SOURCE_PC__Regs. rewrite lookup_insert.
    rewrite writeSuccess__SOURCE_PC__NextPcExact Hnext.
    repeat split; reflexivity.
Qed.

Lemma segment___SOURCE_PC__ (regs : reg_map) (global : seq_global_state)
    (sp : bv 64) old__DEST_UPPER__ :
  regs !! "PC" = Some (RVal_Bits (Z_to_bv 64 0x__SOURCE_PC__)) ->
  regs !! "__SOURCE_REGISTER__" = Some (RVal_Bits sp) ->
  regs !! "__DEST_REGISTER__" = Some old__DEST_UPPER__ ->
  global.(seq_instrs) !! Z_to_bv 64 0x__SOURCE_PC__ = Some a__SOURCE_PC__ ->
  global.(seq_instrs) !! Z_to_bv 64 0x__NEXT_PC__ = Some a__NEXT_PC__ ->
  writeSuccessTraceAssumptions (writeSuccess__SOURCE_PC__Before regs global) ->
  IslaInstructionSegment (writeSuccess__SOURCE_PC__Before regs global)
    (writeSuccess__SOURCE_PC__Observations regs global sp)
    (writeSuccess__SOURCE_PC__After regs global sp) /\
  (writeSuccess__SOURCE_PC__After regs global sp).1.(seq_regs) =
    writeSuccess__SOURCE_PC__Regs regs sp /\
  (writeSuccess__SOURCE_PC__After regs global sp).2.(seq_mem) = global.(seq_mem) /\
  concat (map microLabels (writeSuccess__SOURCE_PC__Observations regs global sp)) = [].
Proof.
  intros Hpc Hsp Hx10 Hcode Hnext Hassumptions.
  eapply segment___SOURCE_PC___mstatus; eauto.
  exact (writeSuccess__SOURCE_PC__MstatusFromTraceAssumptions
    regs global Hassumptions).
Qed.

