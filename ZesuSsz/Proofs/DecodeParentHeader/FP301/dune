; The closed decodeParentHeader block proofs, compiled in place. The caller renderer writes each caller under
; tools/block/generated/decodeparentheader_fp301_callers; this directory only copies the closed ones into the ZesuSsz
; theory, so the compliance theorem can consume them. Edit the callers through their renderers.
(rule (targets Caller0040.v) (deps ../../../../tools/block/generated/decodeparentheader_fp301_callers/Caller0040.v) (action (copy ../../../../tools/block/generated/decodeparentheader_fp301_callers/Caller0040.v Caller0040.v)))
(rule (targets Caller0054.v) (deps ../../../../tools/block/generated/decodeparentheader_fp301_callers/Caller0054.v) (action (copy ../../../../tools/block/generated/decodeparentheader_fp301_callers/Caller0054.v Caller0054.v)))
