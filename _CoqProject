-Q _build/default/generated/isla-traces/entrypoints IslaTraces.entrypoints
-Q _build/default/generated/isla-traces/zkvm_exit IslaTraces.zkvm_exit
-Q _build/default/generated/isla-traces/allocator_get IslaTraces.allocator_get
