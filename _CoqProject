# Load paths for Rocq tools that do not read dune.
-Q _build/default/ZesuSsz ZesuSsz
-Q _build/default/InstrSpecs InstrSpecs
-Q _build/default/MachineMap ZesuMachineMap
-R _build/default/generated/isla-traces IslaTraces
-Q _build/default/ZesuSsz/Contracts/CalleeIdentity ZesuSsz.CalleeIdentity
-Q _build/default/generated/isla-traces/stock-zisk/decodeItem ZesuSsz.Stock.DecodeItem
-Q _build/default/generated/isla-traces/stock-zisk/closure ZesuSsz.Stock.Closure
-Q _build/default/generated/evm-sail-coq EvmSail
-Q _build/default/generated/evm-sail-coq/rlp EvmSailRlp
-Q _build/default/generated/sail-stdpp SailStdpp

-arg -w -arg -notation-overridden
-arg -w -arg -redundant-canonical-projection
