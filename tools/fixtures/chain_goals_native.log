CHAIN-GOAL-BEGIN "active"
CHAIN-GOAL-LOCAL Hdebt : (0 ≤ bv_unsigned sp + 1)%Z CHAIN-FIELD-END
CHAIN-GOAL-SORT Hdebt : Prop CHAIN-FIELD-END
CHAIN-GOAL-LOCAL Hbound : (0 ≤ bv_unsigned sp)%Z CHAIN-FIELD-END
CHAIN-GOAL-SORT Hbound : Prop CHAIN-FIELD-END
CHAIN-GOAL-LOCAL tail : spec CHAIN-FIELD-END
CHAIN-GOAL-SORT tail : Type CHAIN-FIELD-END
CHAIN-GOAL-LOCAL sp : (bv 64) CHAIN-FIELD-END
CHAIN-GOAL-SORT sp : Set CHAIN-FIELD-END
CHAIN-GOAL-LOCAL H : threadG CHAIN-FIELD-END
CHAIN-GOAL-SORT H : Set CHAIN-FIELD-END
CHAIN-GOAL-LOCAL islaG0 : (islaG Sigma) CHAIN-FIELD-END
CHAIN-GOAL-SORT islaG0 : Type CHAIN-FIELD-END
CHAIN-GOAL-LOCAL Sigma : gFunctors CHAIN-FIELD-END
CHAIN-GOAL-SORT Sigma : Type CHAIN-FIELD-END
CHAIN-GOAL-ENV iris CHAIN-FIELD-END
"CHAIN-GOAL-PERSISTENT" (mmio_range 604086464 16) CHAIN-FIELD-END
"CHAIN-GOAL-SPATIAL" (bv_unsigned sp ↦ₘ 8)%I CHAIN-FIELD-END
"CHAIN-GOAL-SPATIAL" (spec_trace (scons (SWriteMem 604086464 8%bv) tail)) CHAIN-FIELD-END
CHAIN-GOAL-CONCLUSION True%I CHAIN-FIELD-END
CHAIN-TRACE-WIDTH 604086464%bv : 64%N
BOUNDARY-ADDRESS-WIDTH sp : 64%N
CHAIN-MEMORY-WIDTH (bv_unsigned sp) : 64%N
CHAIN-GOAL-END
