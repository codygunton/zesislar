CHAIN-GOAL-BEGIN "active"
CHAIN-GOAL-LOCAL secondValue : nat CHAIN-FIELD-END
CHAIN-GOAL-SORT secondValue : Set CHAIN-FIELD-END
CHAIN-GOAL-VALUE secondValue : (x + 5) CHAIN-FIELD-END
CHAIN-GOAL-LOCAL firstValue : nat CHAIN-FIELD-END
CHAIN-GOAL-SORT firstValue : Set CHAIN-FIELD-END
CHAIN-GOAL-VALUE firstValue : (x + 3) CHAIN-FIELD-END
CHAIN-GOAL-LOCAL x : nat CHAIN-FIELD-END
CHAIN-GOAL-SORT x : Set CHAIN-FIELD-END
CHAIN-GOAL-ENV coq CHAIN-FIELD-END
CHAIN-GOAL-CONCLUSION (x = x) CHAIN-FIELD-END
CHAIN-GOAL-END
